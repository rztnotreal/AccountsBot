# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...ВСТАВЬТЕ_СЮДА

# Telegram ID администраторов (через запятую). Узнать: @userinfobot или команда /id
ADMIN_IDS=111111111,222222222

# Ограничить бота конкретными чатами (id групп/каналов, через запятую).
# Пусто = бот работает везде (в группах и в личке).
ALLOWED_CHAT_IDS=-1001234567890

# PostgreSQL. Можно задать одним URL...
DATABASE_URL=postgres://postgres:password@localhost:5432/claude_accounts

# ...либо по частям (если DATABASE_URL не задан):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=claude_accounts

# Часовой пояс для дат в сообщениях
TZ=Europe/Moscow
